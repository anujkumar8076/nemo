# Local-only values. Never put real credentials in this file.
AUTODEV_ENVIRONMENT=development
AUTODEV_LOG_LEVEL=INFO
AUTODEV_API_PORT=8000
AUTODEV_WEB_PORT=3000
AUTODEV_DATABASE_URL=postgresql+psycopg://autodev:autodev@postgres:5432/autodev
AUTODEV_REDIS_URL=redis://redis:6379/0
AUTODEV_TEMPORAL_ADDRESS=temporal:7233
AUTODEV_TEMPORAL_NAMESPACE=default
AUTODEV_API_INTERNAL_URL=http://api:8000
AUTODEV_AUTH_MODE=bootstrap
AUTODEV_BOOTSTRAP_API_TOKEN=local-development-token-change-before-use-000000000000
AUTODEV_BOOTSTRAP_USER_ID=00000000-0000-4000-8000-000000000001
AUTODEV_BOOTSTRAP_USER_EMAIL=developer@example.invalid
AUTODEV_BOOTSTRAP_USER_NAME=Local Developer
AUTODEV_BOOTSTRAP_ORGANIZATION_ID=00000000-0000-4000-8000-000000000002
AUTODEV_BOOTSTRAP_ORGANIZATION_NAME=Local Workspace
AUTODEV_BOOTSTRAP_ORGANIZATION_SLUG=local-workspace
AUTODEV_GITHUB_INTEGRATION_ENABLED=false
AUTODEV_GITHUB_WEBHOOK_SECRET=local-github-webhook-secret-change-before-use-000000
AUTODEV_GITHUB_WEBHOOK_MAX_BODY_BYTES=2000000
AUTODEV_GITHUB_REMOTE_ACTIONS_ENABLED=false
AUTODEV_GITHUB_APP_ID=
AUTODEV_GITHUB_PRIVATE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
POSTGRES_DB=autodev
POSTGRES_USER=autodev
POSTGRES_PASSWORD=autodev
